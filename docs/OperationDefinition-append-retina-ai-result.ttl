  ] ; # 
  fhir:version [ fhir:v "0.2.0"] ; # 
  fhir:name [ fhir:v "AppendRetinaAIResult"] ; # 
  fhir:title [ fhir:v "Retina Append AI Result Operation"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:kind [ fhir:v "operation"] ; # 
  fhir:date [ fhir:v "2025-11-30T22:57:21+01:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "DIPS AS"] ; # 
  fhir:contact ( [
