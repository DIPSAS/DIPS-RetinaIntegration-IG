@startuml diagnostic-report-with-ai

!theme plain
skinparam backgroundColor #FFFFFF

' --- Skin Parameters for a Clean Look ---

' This is the correct command to hide all visibility markers (+, -, #)
' It's the standard way to achieve a diagram without these icons.
hide circle

' Use orthogonal lines for cleaner relationships
' skinparam linetype ortho

' Add spacing between elements
'skinparam nodesep 120
'skinparam ranksep 120

' --- Define FHIR Resources as Classes ---

class rdr as "RetinaDiagnosticReport" <<DiagnosticReport>>{
  imagingStudy: RetinaImagingStudy[]
  result[hbA1cObservation]: HbA1cObservation
  result[drFinding]: DiabeticRetinopathyFinding
  result[dmeFinding]: DiabeticMacularEdemaFinding
  result[imageQuality]: ImageQuality
  ext[daysUntilNextExamination]: Integer
  ext[cautions]: Codes from 5000 series
  ext[previousExaminationConclusion]: Code from 1000 series
  code: OCT and/or fundus photography
  conclusionCode: Code from 1000 series
  status: registered | partial | <b>preliminary | final</b>
}

class is as "ImagingStudy" <<ImagingStudy>> {
  identifier: SectraStudyId
  ' partOf: RetinaDiagnosticReport
  status: registered | <b>available</b>
}

class iss as "ImageSeries" <<ImagingStudy.Series>> {
  bodySite: left eye | right eye
  instance: ImageInstance[]
  performer: CameraDevice
}

class issi as "ImageInstance" <<ImagingStudy.Series.Instance>> {
  ext[view]: Code for macula- or optic disc-centered
}

Class CameraDevice <<Device>> {
  model-name: Camera Product Name
  model-number: Camera Version
  software: Camera Protocol
}

class AIDevice <<Device>> {
  model-name: AI Product Name
  model-number: AI Version
  software: AI Protocol
} 

class drf as "DiabeticRetinopathyFinding" <<Observation>> {
  code : http://snomed.info/sct#4855003\n "Diabetic retinopathy"
  value: Quantity : 0.0 - 5.0 
  bodySite: left eye | right eye
  derivedFrom: ImagingStudy
  performer: AIDevice
  ' partOf: RetinaDiagnosticReport
}

class dmef as "DiabeticMacularEdemaFinding" <<Observation>> {
  code: http://snomed.info/sct#312912001\n "Diabetic macular edema"
  value: bool 
  bodySite: left eye | right eye
  derivedFrom: ImagingStudy
  performer: AIDevice
  ' partOf: RetinaDiagnosticReport
}

class iqa as "ImageQualityAssessment" <<Observation>> {
  code: http://snomed.info/sct#133887000\n "Computer assisted image analysis for image quality"
  value: Code from 2000 series
  bodySite: left eye | right eye
  derivedFrom: ImagingStudy
  performer: AIDevice
  ' partOf: RetinaDiagnosticReport
}

class HbA1cObservation <<Observation>> {
  code: snomed "HbA1c"
  value: Quantity
  'partOf: RetinaDiagnosticReport
}

' --- Define the relationships ---

rdr "0..1" o-- HbA1cObservation 
rdr "0..2" o-- drf 
rdr "0..2" o-- dmef
rdr "0..2" o-- iqa
rdr "0..*" o-- is
iqa --> issi : "derived from"
drf --> iss : "derived from"
dmef --> iss : "derived from"
iqa --> AIDevice : "performer"
drf --> AIDevice : "performer"
dmef --> AIDevice : "performer"
' is ..> rdr : "partOf"
is "0..*" o--> iss : "series"
iss "0..*" o--> issi : "instance"
iss --> CameraDevice : "performer"
' iqa ..> rdr : "partOf"
' dmef ..> rdr : "partOf"
' drf ..> rdr : "partOf"
' HbA1cObservation ..> rdr : "partOf"
 
@enduml
