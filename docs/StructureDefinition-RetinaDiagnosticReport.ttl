  fhir:version [ fhir:v "0.1.3"] ; # 
  fhir:name [ fhir:v "DIPSRetinaIntegrationDiagnosticReport"] ; # 
  fhir:title [ fhir:v "Retina DiagnosticReport"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v true] ; # 
  fhir:date [ fhir:v "2025-11-13T17:39:30+01:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "DIPS AS"] ; # 
