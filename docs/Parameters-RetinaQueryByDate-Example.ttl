@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://dips.no/fhir/RetinaIntegration/Parameters/RetinaQueryByDate-Example> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "RetinaQueryByDate-Example"] ; # 
  fhir:parameter ( [
     fhir:name [ fhir:v "start" ] ;
     fhir:value [
       a fhir:DateTime ;
       fhir:v "2026-01-21T00:00:00Z"^^xsd:dateTime
     ]
  ] [
     fhir:name [ fhir:v "end" ] ;
     fhir:value [
       a fhir:DateTime ;
       fhir:v "2026-01-22T00:00:00Z"^^xsd:dateTime
     ]
  ] [
     fhir:name [ fhir:v "pendingAI" ] ;
     fhir:value [
       a fhir:Boolean ;
       fhir:v true
     ]
  ] ) . # 

